rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function isAuth()        { return request.auth != null; }
    function isOwner(uid)    { return request.auth.uid == uid; }
    function isAdmin()       { return request.auth.token.admin == true; }
    function onlyFields(keys){ return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    function fieldLocked(field) {
      return !(field in resource.data) || !(field in request.resource.data) ||
             request.resource.data[field] == resource.data[field];
    }

    // ── players ───────────────────────────────────────────────────────────────
    // Cualquier usuario autenticado puede leer perfiles (rivals, ranking, etc.)
    // Solo el propio usuario puede escribir su documento.
    match /players/{uid} {
      allow read:   if isAuth();
      // 'allow create' no validaba ningún campo -- el alta (Logging.dart,
      // Registrarse_screen.dart) escribe 'monedas: 100, nivel: 1, xp: 0,
      // liga: bronce, puntos_liga: 0' por convención del cliente, pero
      // nada impedía crear la cuenta ya con los valores que uno quisiera.
      // Se exige que el alta tenga exactamente esos valores por defecto y
      // que no incluya ninguno de los campos premium/progreso que solo
      // deberían tocar las Cloud Functions.
      allow create: if isOwner(uid)
        && request.resource.data.monedas     == 100
        && request.resource.data.nivel       == 1
        && request.resource.data.victorias   == 0
        && request.resource.data.xp          == 0
        && request.resource.data.puntos_liga == 0
        && request.resource.data.liga        == 'bronce'
        && !('is_premium' in request.resource.data)
        && !('subscription_plan' in request.resource.data)
        && !('subscription_expires' in request.resource.data)
        && !('boost_xp_activo' in request.resource.data)
        && !('boost_xp_expira' in request.resource.data)
        && !('global_territories_count' in request.resource.data)
        && !('racha_actual' in request.resource.data)
        && !('ultima_fecha_actividad' in request.resource.data);
      // 'monedas' nunca puede bajar desde el cliente — todo descuento
      // (aceptar/enviar desafío, atacar, escudo...) pasa por Cloud Functions
      // transaccionales, que usan el Admin SDK y no están sujetas a esta regla.
      // 'puntos_liga', 'liga', 'racha_actual' y 'ultima_fecha_actividad' quedan
      // completamente bloqueados en update: solo se escriben desde Cloud
      // Functions (sumarPuntosLigaJugador, actualizarRachaDiaria y las
      // funciones de territorio/guerra global). 'nivel' y 'victorias' también
      // se bloquean: hoy no tienen ninguna escritura legítima del cliente.
      // 'xp' y 'global_territories_count' solo deberían moverlos las Cloud
      // Functions (conquista/liga) — no tenían ningún escritor legítimo en
      // el cliente, pero tampoco estaban bloqueados: cualquiera podía
      // escribirlos directo con el SDK público sin pasar por la app.
      // 'is_premium'/'subscription_plan'/'subscription_expires'/
      // 'premium_updated_at' y 'boost_xp_activo'/'boost_xp_expira' se
      // bloquean por el mismo motivo que 'monedas': el cliente se los
      // escribía él mismo sin ninguna verificación de pago real (RevenueCat
      // sigue sin confirmación server-to-server — ver P0.9 del plan de
      // seguridad). Esto deja a CUALQUIERA en estado gratuito hasta que haya
      // una Cloud Function que sincronice un pago verificado — hoy no
      // existe, así que premium queda inactivo para todos hasta construirla.
      // 'premium_welcome_reward' + 'monedas' en la misma escritura
      // (subscription_service.dart _darRecompensaBienvenida) era un vector
      // de monedas gratis independiente de si se puede falsificar el SDK de
      // RevenueCat o no: con el cliente público se podía llamar
      // directamente sin pasar nunca por una compra. 'escudo_activo'/
      // 'escudo_expira' aquí son el escudo A NIVEL DE JUGADOR de esa misma
      // recompensa (no el de territorio, que ya estaba protegido y solo lo
      // escribe la Cloud Function activarEscudo) — hoy nadie lo lee, se
      // bloquea igualmente por si se usa en el futuro. Los 7
      // 'premium_*_limite'/'premium_*' de _activarFeaturesPremium no los
      // lee nada en el cliente (comprobado) — se bloquean por higiene, no
      // por riesgo real.
      allow update: if isOwner(uid) && (
        !('monedas' in resource.data) ||
        !('monedas' in request.resource.data) ||
        request.resource.data.monedas >= resource.data.monedas
      ) && fieldLocked('puntos_liga')
        && fieldLocked('liga')
        && fieldLocked('racha_actual')
        && fieldLocked('ultima_fecha_actividad')
        && fieldLocked('nivel')
        && fieldLocked('victorias')
        && fieldLocked('xp')
        && fieldLocked('global_territories_count')
        && fieldLocked('is_premium')
        && fieldLocked('premium_welcome_reward')
        && fieldLocked('escudo_activo')
        && fieldLocked('escudo_expira')
        && fieldLocked('premium_radio_radar')
        && fieldLocked('premium_historial_limite')
        && fieldLocked('premium_rutas_limite')
        && fieldLocked('premium_estilos_mapa')
        && fieldLocked('premium_stats_avanzadas')
        && fieldLocked('premium_retos_extra')
        && fieldLocked('premium_animacion_conquista')
        && fieldLocked('subscription_plan')
        && fieldLocked('subscription_expires')
        && fieldLocked('premium_updated_at')
        && fieldLocked('boost_xp_activo')
        && fieldLocked('boost_xp_expira');
      allow delete: if false;
    }

    // ── territories ──────────────────────────────────────────────────────────
    // Lectura pública entre autenticados (mapa compartido).
    // La creación pasa exclusivamente por la Cloud Function 'crearTerritorio',
    // que revalida área/cierre/velocidad con el Admin SDK (ver riskrunner/index.js).
    // Antes se permitía escribir directo desde el cliente comprobando solo
    // userId == auth.uid, sin validar área ni cierre del lazo — cualquiera con
    // las credenciales públicas del SDK podía crear un territorio en cualquier
    // sitio sin haber corrido. El cliente ya no debe escribir aquí directamente.
    // 'hp'/'ultimaActualizacionHp'/'ultima_visita' (reforzarTerritorio) y
    // 'rey_id'/'rey_nickname'/'rey_desde' (coronarRey) eran el único resto
    // de escritura directa que quedaba -- el dueño podía curarse el HP a
    // cualquier valor o coronarse rey sin esperar los 14 días de dominio,
    // porque esta regla solo comprobaba el userId, no los valores. Ahora
    // ambas Cloud Functions son el único camino: no queda ningún campo
    // legítimamente escribible por el cliente en este documento.
    // Las Cloud Functions (admin SDK) ignoran estas reglas — tienen acceso total.
    match /territories/{docId} {
      allow read:   if isAuth();
      allow create: if false;
      allow update: if false;
      allow delete: if isAuth() && resource.data.userId == request.auth.uid;

      // Historial de conquistas — solo lectura, escritura exclusiva de Cloud Functions
      match /history/{historyId} {
        allow read:  if isAuth();
        allow write: if false;
      }
    }

    // ── presencia_activa ──────────────────────────────────────────────────────
    // Cada usuario escribe solo su propio doc de presencia (doc ID = uid).
    match /presencia_activa/{uid} {
      allow read:   if isAuth();
      allow write:  if isOwner(uid);
    }

    // ── routes ────────────────────────────────────────────────────────────────
    // Cualquier autenticado puede leer (el filtro de privacidad se aplica en cliente).
    // Solo el dueño crea/borra/renombra. Cualquier autenticado puede incrementar
    // runs_count/saves_count (correr o guardar una ruta ajena).
    // 'monedas_acreditadas' y 'monedasGanadas' quedan bloqueados para el dueño:
    // los escribe la Cloud Function acreditarRecompensaRuta -- si el dueño
    // pudiera resetear 'monedas_acreditadas' a false, podría reclamar la
    // misma ruta varias veces.
    match /routes/{routeId} {
      allow read:   if isAuth();
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuth() && (
        (resource.data.userId == request.auth.uid
          && fieldLocked('monedas_acreditadas')
          && fieldLocked('monedasGanadas')) ||
        onlyFields(['runs_count', 'saves_count'])
      );
      allow delete: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // ── activity_logs ─────────────────────────────────────────────────────────
    // Cualquier autenticado puede leer (necesario para ver stats de otros jugadores).
    // Solo el propietario puede crear sus propios logs.
    match /activity_logs/{logId} {
      allow read:   if isAuth();
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    // ── desafios ──────────────────────────────────────────────────────────────
    // Solo los participantes pueden leer y actualizar.
    // El retador puede crear. Cloud Functions resuelven el estado final.
    match /desafios/{desafioId} {
      allow read:   if isAuth() && (
        resource.data.retadorId == request.auth.uid ||
        resource.data.retadoId  == request.auth.uid
      );
      // La creación (enviar desafío) y la activación (aceptar desafío) implican
      // cobrar la apuesta — solo las Cloud Functions transaccionales
      // (Admin SDK, no sujetas a estas reglas) pueden hacerlo. Cancelar y
      // rechazar también implican mover monedas (reembolso) — solo la
      // Cloud Function 'cancelarDesafio' puede hacerlo; antes el cliente
      // podía poner estado='cancelado'/'rechazado' aquí directamente y
      // reembolsarse aparte escribiendo 'monedas' en players/, sin pasar
      // por ninguna validación de servidor. 'contrapropuesta' sigue
      // permitida directamente: no mueve dinero, solo propone términos.
      allow create: if false;
      allow update: if isAuth() && (
        resource.data.retadorId == request.auth.uid ||
        resource.data.retadoId  == request.auth.uid
      )
        && request.resource.data.estado != 'activo'
        && request.resource.data.estado != 'cancelado'
        && request.resource.data.estado != 'rechazado';
      allow delete: if false;
    }

    // ── notifications ─────────────────────────────────────────────────────────
    // El destinatario puede leer. Solo puede marcar como leída (campo 'read').
    // Al crear: el remitente debe identificarse con su propio uid.
    match /notifications/{notifId} {
      allow read:   if isAuth() && resource.data.toUserId == request.auth.uid;
      allow create: if isAuth()
        && request.resource.data.toUserId is string
        && (
          !('fromUserId' in request.resource.data) ||
          request.resource.data.fromUserId == request.auth.uid
        );
      allow update: if isAuth()
        && resource.data.toUserId == request.auth.uid
        && onlyFields(['read']);
      allow delete: if false;
    }

    // ── global_territories ───────────────────────────────────────────────────
    // Solo lectura para el cliente. Escritura exclusiva de Cloud Functions.
    match /global_territories/{docId} {
      allow read:  if isAuth();
      allow write: if false;

      match /historial_semanal/{semanaId} {
        allow read:  if isAuth();
        allow write: if false;
      }
    }

    // ── guerra_global_semanas / logs ─────────────────────────────────────────
    match /guerra_global_semanas/{semanaId} {
      allow read:  if isAuth();
      allow write: if false;
    }
    match /guerra_global_logs/{logId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // ── temporadas ────────────────────────────────────────────────────────────
    match /temporadas/{id} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }

    // ── zonas ─────────────────────────────────────────────────────────────────
    match /zonas/{id} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }

    // ── titulos_rey ───────────────────────────────────────────────────────────
    match /titulos_rey/{id} {
      allow read:  if isAuth();
      allow write: if false;
    }

    // ── clans ─────────────────────────────────────────────────────────────────
    match /clans/{clanId} {
      allow read:   if isAuth();
      allow create: if isAuth() && request.resource.data.leaderId == request.auth.uid;
      allow update: if isAuth() && resource.data.leaderId == request.auth.uid;
      allow delete: if false;
    }

    // ── clan_invites ──────────────────────────────────────────────────────────
    match /clan_invites/{inviteId} {
      allow read:   if isAuth() && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toUid   == request.auth.uid
      );
      allow create: if isAuth() && request.resource.data.fromUid == request.auth.uid;
      allow update: if isAuth() && resource.data.toUid == request.auth.uid
        && onlyFields(['estado']);
      allow delete: if false;
    }

    // ── clan_wars ─────────────────────────────────────────────────────────────
    // La creación pasa exclusivamente por la Cloud Function 'declararGuerra'
    // (revalida rol líder/capitán y ausencia de guerra activa duplicada con
    // el Admin SDK). Antes 'create' solo exigía que 'creatorUid' coincidiera
    // con el propio uid, sin comprobar el rol -- cualquier miembro normal
    // podía declarar guerra. 'update' permitía a cualquier participante
    // escribir puntuacion/estado/ganadorId directamente -- se bloquea del
    // todo porque hoy no existe ningún flujo legítimo que escriba aquí
    // (ninguna acción de juego llama a lo que antes sumaba puntos).
    match /clan_wars/{warId} {
      allow read:   if isAuth();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // ── friendships ──────────────────────────────────────────────────────────
    match /friendships/{docId} {
      allow read:   if isAuth() && (
        resource.data.senderId   == request.auth.uid ||
        resource.data.receiverId == request.auth.uid
      );
      allow create: if isAuth() && request.resource.data.senderId == request.auth.uid;
      allow update: if isAuth() && (
        resource.data.senderId   == request.auth.uid ||
        resource.data.receiverId == request.auth.uid
      );
      allow delete: if isAuth() && (
        resource.data.senderId   == request.auth.uid ||
        resource.data.receiverId == request.auth.uid
      );
    }

    // ── chats + messages ──────────────────────────────────────────────────────
    match /chats/{chatId} {
      allow read:   if isAuth() && request.auth.uid in resource.data.participants;
      allow create: if isAuth() && request.auth.uid in request.resource.data.participants;
      allow update: if isAuth() && request.auth.uid in resource.data.participants;
      allow delete: if false;

      match /messages/{msgId} {
        allow read:   if isAuth() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isAuth()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && request.resource.data.senderId == request.auth.uid;
        allow update: if false;
        allow delete: if false;
      }
    }

    // ── follows ───────────────────────────────────────────────────────────────
    match /follows/{followId} {
      allow read:   if isAuth();
      allow create: if isAuth() && request.resource.data.followerId == request.auth.uid;
      allow delete: if isAuth() && resource.data.followerId == request.auth.uid;
      allow update: if false;
    }

    // ── posts + comments ──────────────────────────────────────────────────────
    match /posts/{postId} {
      allow read:   if isAuth();
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuth() && (
        resource.data.userId == request.auth.uid ||
        onlyFields(['likes', 'saved', 'comentariosCount'])
      );
      allow delete: if isAuth() && resource.data.userId == request.auth.uid;

      match /comments/{commentId} {
        allow read:   if isAuth();
        allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
        allow delete: if isAuth() && resource.data.userId == request.auth.uid;
        allow update: if false;
      }
    }

    // ── stories ───────────────────────────────────────────────────────────────
    match /stories/{storyId} {
      allow read:   if isAuth();
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuth() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    // ── activity_feed ─────────────────────────────────────────────────────────
    match /activity_feed/{docId} {
      allow read:   if isAuth();
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    // ── anticheat_logs ────────────────────────────────────────────────────────
    match /anticheat_logs/{logId} {
      allow read:   if isAdmin();
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // ── coin_purchases ────────────────────────────────────────────────────────
    // Solo la Cloud Function acreditarCompraMonedas escribe aquí -- el ID del
    // documento es el transactionId de RevenueCat, usado como guarda
    // anti-repetición (una compra no puede acreditarse dos veces). Antes el
    // cliente podía crear estos registros directamente, lo que hacía
    // inútil cualquier deduplicación por ID.
    match /coin_purchases/{id} {
      allow read:   if isAuth() && resource.data.userId == request.auth.uid;
      allow write:  if false;
    }

    // ── soporte_mensajes ─────────────────────────────────────────────────────
    // Reportes de "Ayuda > Reportar un problema". El usuario crea el suyo;
    // solo un admin puede leerlos (revisión manual, sin panel de cliente).
    match /soporte_mensajes/{id} {
      allow read:   if isAdmin();
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // ── reportes_usuarios ────────────────────────────────────────────────────
    // Denuncias de "Bloquear/Denunciar" en el perfil de otro jugador. Solo un
    // admin puede leerlas — el cliente nunca ve denuncias, ni las propias.
    match /reportes_usuarios/{id} {
      allow read:   if isAdmin();
      allow create: if isAuth() && request.resource.data.reportanteId == request.auth.uid;
      allow update, delete: if false;
    }

    // ── reportes_posts ───────────────────────────────────────────────────────
    // Denuncias de publicaciones del feed ("..." > Reportar publicación).
    // Solo un admin puede leerlas — el cliente nunca ve reportes.
    match /reportes_posts/{id} {
      allow read:   if isAdmin();
      allow create: if isAuth() && request.resource.data.reportanteId == request.auth.uid;
      allow update, delete: if false;
    }

    // ── daily_challenges ─────────────────────────────────────────────────────
    match /daily_challenges/{id} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }

    // ── active_runners ────────────────────────────────────────────────────────
    match /active_runners/{docId} {
      allow read:  if isAuth();
      allow write: if false;
    }

    // ── training_plans ────────────────────────────────────────────────────────
    // Cada usuario lee y escribe solo su propio plan activo (doc ID = uid).
    match /training_plans/{uid} {
      allow read, write: if isOwner(uid);
    }

    // ── training_plan_history ─────────────────────────────────────────────────
    // Cada usuario puede leer y crear entradas en su propio historial.
    match /training_plan_history/{uid}/plans/{planId} {
      allow read, create: if isOwner(uid);
      allow update, delete: if false;
    }

    // ── jarvis_hq ─────────────────────────────────────────────────────────────
    // Panel empresarial JARVIS. Solo el propio usuario accede a sus datos.
    match /jarvis_hq/{uid}/departments/{dept} {
      allow read, write: if isOwner(uid);
    }
    // Historial de chat: el cliente solo lee; las Cloud Functions escriben (admin SDK).
    match /jarvis_hq/{uid}/memory/{msgId} {
      allow read: if isOwner(uid);
      allow write: if false;
    }
    // Configuración de usuario (misión activa, preferencias, etc.).
    match /jarvis_hq/{uid}/config/{doc} {
      allow read, write: if isOwner(uid);
    }
    // Alertas temporizadas creadas por JARVIS o el CEO.
    match /jarvis_hq/{uid}/alerts/{alertId} {
      allow read, write: if isOwner(uid);
    }
    // Calendario de tareas y eventos.
    match /jarvis_hq/{uid}/calendar/{eventId} {
      allow read, write: if isOwner(uid);
    }

    // ── beta_candidates ───────────────────────────────────────────────────────
    // Solo Cloud Functions (admin SDK) pueden leer/escribir. El cliente nunca toca esta colección.
    match /beta_candidates/{docId} {
      allow read, write: if false;
    }

    // ── Denegar todo lo demás ─────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
